div(ng-controller='FixedProfileCtrl')
  section.settings-group.settings-group-fixed-servers
    h3 {{'options_group_proxyServers' | tr}}
    .table-responsive
      table.fixed-servers.table.table-bordered.table-striped.width-limit-xl
        thead
          tr
            th {{'options_scenes_column' | tr}}
            th {{'options_proxy_scheme' | tr}}
            th {{'options_proxy_protocol' | tr}}
            th {{'options_proxy_server' | tr}}
            th {{'options_proxy_port' | tr}}
            th
        tbody(ng-repeat='sceneRow in sceneRows track by sceneRow.id')
          tr(ng-repeat='scheme in urlSchemes'
            ng-show='scheme == "" || showAdvanced')
            td.fixed-scene-cell(ng-if='$first'
              ng-attr-rowspan='{{showAdvanced ? urlSchemes.length : 1}}')
              strong {{sceneRow.name}}
              span.label.label-success(ng-if='isActiveScene(sceneRow)')
                | {{'options_scenes_active' | tr}}
            td {{schemeDisp[scheme] || ('options_scheme_default' | tr)}}
            td
              select.form-control(ng-model='sceneRow.proxyEditors[scheme].scheme'
                ng-options='opt.value as opt.label for opt in optionsForScheme[scheme]'
                ng-change='updateProxy(sceneRow, scheme)')
            td(ng-if='sceneRow.proxyEditors[scheme].scheme')
              input.form-control(type='text'
                ng-model='sceneRow.proxyEditors[scheme].host' required)
            td(ng-if='!sceneRow.proxyEditors[scheme].scheme')
              input.form-control(type='text' value=''
                placeholder='{{sceneRow.proxyEditors[""].host}}' disabled)
            td(ng-if='sceneRow.proxyEditors[scheme].scheme')
              input.form-control(type='number' min='1'
                ng-model='sceneRow.proxyEditors[scheme].port' required)
            td(ng-if='!sceneRow.proxyEditors[scheme].scheme')
              input.form-control(type='number' value=''
                placeholder='{{sceneRow.proxyEditors[""].port}}' disabled)
            td.proxy-actions
              button.btn.btn-xs.proxy-auth-toggle(
                ng-class='isProxyAuthActive(sceneRow, scheme) ? "btn-success" : "btn-default"'
                type='button' role='button'
                ng-click='editProxyAuth(sceneRow, scheme)'
                ng-disabled='!sceneRow.proxyEditors[scheme].scheme'
                title='{{"options_proxy_auth" | tr}}')
                span.glyphicon.glyphicon-lock
          tr
            td(colspan='6')
              div.checkbox
                label
                  input(type='checkbox' ng-model='sceneRow.proxyDNS'
                    ng-change='updateProxyDNS(sceneRow)')
                  span {{'options_proxy_proxyDNS' | tr}}
                p.help-block(omega-html="'options_proxy_proxyDNSHelp' | tr")
        tbody(ng-if='!showAdvanced')
          tr.fixed-show-advanced
            td(colspan='6')
              button.btn.btn-link(type='button' ng-click='showAdvanced = true')
                | #[span.glyphicon.glyphicon-chevron-down] {{'options_proxy_expand' | tr}}
        tbody
          tr
            td(colspan='6')
              .btn-group(dropdown)
                button.btn.btn-default.dropdown-toggle(type='button'
                  dropdown-toggle aria-haspopup='true'
                  ng-disabled='!availableScenes().length')
                  span.glyphicon.glyphicon-plus
                  = ' '
                  | {{'options_scenes_add' | tr}}
                  span.caret
                ul.dropdown-menu(role='menu')
                  li(role='menuitem' ng-repeat='scene in availableScenes()')
                    a(ng-click='addScene(scene)') {{scene.name}}
              = ' '
              a(ui-sref='scenes') {{'options_tab_scenes' | tr}}
  section.settings-group
    h3 {{'options_group_bypassList' | tr}}
    p.help-block {{'options_bypassListHelp' | tr}}
    p.help-block
      a(href='https://developer.chrome.com/extensions/proxy#bypass_list' target='_blank')
        | {{'options_bypassListHelpLinkText' | tr}}
    .form-group(ng-repeat='sceneRow in sceneRows track by sceneRow.id')
      label {{sceneRow.name}}
      textarea.monospace.form-control.width-limit(rows='10'
        ng-model='sceneRow.bypassList' ng-model-options="{updateOn:'blur'}"
        ng-change='updateBypassList(sceneRow)')
